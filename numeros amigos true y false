def son_amigos(n, n2):
    suma = 0
    suma2 = 0

    for i in range(1, (n // 2) + 1):
        if n % i == 0:
            suma += i
            
    for i in range(1, (n2 // 2) + 1):
        if n2 % i == 0:
            suma2 += i

    return suma == n2 and suma2 == n
num1 = int(input("Ingrese el primer número: "))
num2 = int(input("Ingrese el segundo número: "))

if son_amigos(num1, num2):
    print(f"¡Sí! {num1} y {num2} son números amigos.")
else:
    print(f"No, {num1} y {num2} no son números amigos.")
