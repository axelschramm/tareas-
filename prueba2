#3 Desarrolle una función que reciba un número como argumento, y retorne el siguiente número primo que encuentre después del número recibido como parámetro
def siguiente(n):
    n = n + 1
    while True:
        contador = 0
        for i in range (1,n+1):
            if n % i == 0:
                contador = contador + 1
        if contador == 2:
            return n
        n = n + 1
numero= int(input("Ingrese su dígito: "))
primo = siguiente(numero)
print("El siguiente número primo es", primo)


#4 Desarrolle una función que reciba un numero como argumento y retorne el primer dígito de ese número, la función debe validar que el número recibido sea positivo y menor a cien mil, de lo contrario retorna un cero que el argumento no cumple con las restricciones.
def primer_digito(numero):
    if numero <= 0 or numero >= 100000:
        return 0
    while numero >= 10:
        numero = numero // 10
    return numero 

numero = int(input("Ingrese su numero: "))
digito = primer_digito(numero)

if digito == 0:
    print("El argumento no cumple con las restricciones")
else:
    print("El primer dígito es igual a", digito)

