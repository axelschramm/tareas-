def siguiente_primo(numero):
    numero = numero + 1
    while True:
        contador = 0
        for x in range (1,numero+1):
            if numero % x == 0:
                contador = contador + 1
        if contador == 2:
            return numero
        numero = numero + 1
num = int(input("Ingrese su dígito: "))
primo = siguiente_primo(num)
print("El siguiente número primo es", primo)
