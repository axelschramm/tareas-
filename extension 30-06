limite = int(input("Ingresa el número máximo: "))

ata = 1
while ata <= limite:
    print(ata, end="")
    
    ata1 = 1
    while ata1 < ata:
        print(ata1, end="")
        ata1 += 1
        
    ata += 1
    print(ata - 1)

ata = limite - 1
while ata >= 1:
    print(ata, end="")
    
    ata1 = 1
    while ata1 < ata:
        print(ata1, end="")
        ata1 += 1
        
    ata -= 1
    print(ata + 1)
