def perfecto(n):
    if n <2:
        return False
    
    suma = 0
    for i in range(1, (n // 2) + 1):
        if n % i == 0:
            suma=suma+i
    return suma ==n
numero = int(input("Introduce un número  para ver si es perfecto: "))
if perfecto(numero):
        print(f"El número {numero} es un número perfecto")
        print(f"es perfecto porque la suma de todos sus divisores dan el mismo numero  ")
else:
        print(f"El número {numero} no es un número perfecto.")
        print(f"no es perfecto porque la suma de divisores no dan el mismo numero ")
